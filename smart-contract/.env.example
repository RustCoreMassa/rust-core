# Private key of the deployer — it becomes the Launchpad admin. Never commit .env.
PRIVATE_KEY=

# buildnet (default) or mainnet
NETWORK=buildnet

# Launchpad config at deploy time (MAS, except the presale and marketplace fees in basis
# points: 100 = 1%). Defaults are small test values for buildnet; mainnet values are still to be
# decided.
TOKEN_FEE_MAS=1
COLLECTION_FEE_MAS=1
IMPORT_FEE_MAS=0.5
PRESALE_FEE_BPS=200
MARKET_FEE_BPS=100
DEPLOY_DEPOSIT_MAS=0.1

# Fair Launch (npm run deploy:fair-launch). Fees in MAS, except the trade and graduation fees in
# basis points. FAIR_TARGET_MAS = MAS a curve raises before it moves to Dusa (100 minimum).
# LAUNCHPAD=<address> picks the Launchpad whose token template it uses (default: the app's).
FAIR_CREATION_FEE_MAS=1
FAIR_TRADE_FEE_BPS=100
FAIR_GRADUATION_FEE_BPS=200
FAIR_TARGET_MAS=100
FAIR_DEPLOY_DEPOSIT_MAS=0.1
FAIR_AUTO_GRADUATE_GAS=900000000
