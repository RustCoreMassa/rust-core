# Private key of the deployer — it becomes the Launchpad admin. Never commit .env.
PRIVATE_KEY=

# buildnet (default) or mainnet
NETWORK=buildnet

# Launchpad config at deploy time (MAS, except the presale and marketplace fees in basis
# points: 100 = 1%). Defaults are small test values for buildnet; mainnet values are still to be
# decided.
TOKEN_FEE_MAS=1
COLLECTION_FEE_MAS=1
IMPORT_FEE_MAS=0.5
PRESALE_FEE_BPS=200
MARKET_FEE_BPS=100
DEPLOY_DEPOSIT_MAS=0.1

# Fair Launch (npm run deploy:fair-launch). Fees in MAS, except the trade and graduation fees in
# basis points. FAIR_TARGET_MAS = MAS a curve raises before it moves to Dusa (100 minimum; below
# ~197 the deferred call, ~9.85 MAS for 980 M gas, costs more than the 5 % allowed: no
# self-graduation). LAUNCHPAD=<address> picks the Launchpad whose token template it uses
# (default: the app's).
# Launch fee (mainnet default 50), less the Launchpad's holder discount.
FAIR_CREATION_FEE_MAS=1
FAIR_TRADE_FEE_BPS=100
FAIR_GRADUATION_FEE_BPS=200
FAIR_TARGET_MAS=200
FAIR_DEPLOY_DEPOSIT_MAS=0.1
FAIR_AUTO_GRADUATE_GAS=980000000
# Minutes a curve trades before it may sell out and move to Dusa (mainnet default 1440 = 24 h).
FAIR_MIN_CURVE_MINUTES=10
